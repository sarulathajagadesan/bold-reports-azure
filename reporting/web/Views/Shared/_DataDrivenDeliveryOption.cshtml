@{
    var schemaList = ViewBag.SchemaList as List<object> ?? new List<object>();

    var datasetFieldOptions = new List<SelectListItem>();
    if (schemaList.Count > 0)
    {
        foreach (var schema in schemaList)
        {
            dynamic schemaObj = schema;
            string columnName = schemaObj.Name ?? schemaObj.ToString();
            datasetFieldOptions.Add(new SelectListItem { Text = columnName, Value = columnName });
        }
    }

    var mailOptionsFields = new[] {
        new { Key = "EmailContent",   Label = "[[[Email Content]]]",    Type = "Template", Placeholder = "Enter email content"    },
        new { Key = "RecipientMail",  Label = "[[[RecipientMail Email]]]",  Type = "text",     Placeholder = "Enter recipient email" },
        new { Key = "ReplyTo",        Label = "[[[Reply To]]]",         Type = "text",     Placeholder = "Enter reply-to email"   }
    };

    var localStorageFields = new[]
    {
        new { Key = "Path",             Label = "[[[Path]]]",             Type = "text",   Placeholder = "Enter path"   },
        new { Key = "FileOverwrite",    Label = "[[[File Overwrite]]]",   Type = "bool",   Placeholder = ""             },
        new { Key = "NotifyRecipients", Label = "[[[Notify Recipients]]]",Type = "bool",   Placeholder = ""             },
        new { Key = "SaveAsRecipientMail",    Label = "[[[RecipientMail Email]]]",  Type = "text",   Placeholder = "Enter recipient email" },
        new { Key = "MaxReportCount",   Label = "[[[Max Report Count]]]", Type = "number", Placeholder = "Enter number" }
    };

    var s3StorageFields = new[]
    {
        new { Key = "AccessKey",  Label = "[[[Access Key]]]",  Type = "text",     Placeholder = ""          },
        new { Key = "SecretKey",  Label = "[[[Secret Key]]]",  Type = "password", Placeholder = ""          },
        new { Key = "BucketName", Label = "[[[Bucket Name]]]", Type = "text",     Placeholder = ""          },
        new { Key = "Region",     Label = "[[[Region]]]",      Type = "text",     Placeholder = "us-east-1" }
    };

    var ftpStorageFields = new[]
    {
        new { Key = "FtpHost",     Label = "[[[Host]]]",     Type = "text",     Placeholder = "" },
        new { Key = "FtpUsername", Label = "[[[Username]]]", Type = "text",     Placeholder = "" },
        new { Key = "FtpPassword", Label = "[[[Password]]]", Type = "password", Placeholder = "" }
    };
}

<div class="delivery-options-wrapper" id="Delivery-Option-body">
    <div class="delivery-grid">

        @{
            var exportSettingsFields = new[]
            {
                new { Key = "FileFormat",                  Label = "[[[File Format]]]",                   Type = "text",   Placeholder = "Enter file format"     },
                new { Key = "ExportFileName",              Label = "[[[Export File Name]]]",              Type = "text",   Placeholder = "Enter file name"       },
                new { Key = "IsCompressionEnabled",        Label = "[[[Compression Enabled]]]",           Type = "bool",   Placeholder = ""                      },
                new { Key = "IsPasswordProtected",         Label = "[[[Password Protected]]]",            Type = "bool",   Placeholder = ""                      },
                new { Key = "Password",                    Label = "[[[Password]]]",                      Type = "text",   Placeholder = "Enter password"        },
                new { Key = "AttachmentName",              Label = "[[[Attachment Name]]]",               Type = "text",   Placeholder = "Enter attachment name" },
                new { Key = "OwnerFailureNotification",    Label = "[[[Owner Failure Notification]]]",    Type = "bool",   Placeholder = ""                      },
                new { Key = "RecipientFailureNotification",Label = "[[[Recipient Failure Notification]]]",Type = "bool",   Placeholder = ""                      },
                new { Key = "IsNoDataEnabled",             Label = "[[[No Data Enabled]]]",               Type = "bool",   Placeholder = ""                      }
            };
        }

        @foreach (var field in exportSettingsFields)
        {
            <div class="delivery-row row" data-row-key="@field.Key">

                <label class="col-form-label">@Html.Raw(field.Label)</label>

                <!-- Source: EJ DropDownList -->
                <div class="sourcetype">
                    <select id="@(field.Key)_Source"
                            name="@(field.Key)_Source"
                            class="source-select"
                            data-default="dataset">
                        <option value="dataset">Choose field from dataset</option>
                        <option value="value">Enter value</option>
                    </select>
                </div>

                <!-- Dataset: EJ DropDownList -->
                <div class="dataset-field">
                    <select id="@(field.Key)_Field"
                            name="@(field.Key)_Field"
                            class="dataset-dropdown"
                            data-row-key="@field.Key">
                        @foreach (var opt in datasetFieldOptions)
                        {
                            <option value="@opt.Value">@opt.Text</option>
                        }
                    </select>
                    <span class="text-danger error-message"></span>
                </div>

                <!-- Value -->
                <div class="value-field d-none">
                    @if (field.Type == "bool")
                    {
                        <select id="@(field.Key)_Value"
                                name="@(field.Key)_Value"
                                class="value-input">
                            <option value="">[[[Select]]]</option>
                            <option value="true">[[[True]]]</option>
                            <option value="false">[[[False]]]</option>
                        </select>
                    }
                    else
                    {
                        <input type="@field.Type"
                               class="form-control value-input"
                               placeholder="@field.Placeholder" />
                    }
                    <span class="text-danger error-message"></span>
                </div>
            </div>

            @* ── NoDataActionOption sub-row: visible only for IsNoDataEnabled + dataset source ── *@
            @if (field.Key == "IsNoDataEnabled")
            {
                <div class="delivery-row row no-data-action-row d-none" data-row-key="NoDataActionOption">
                    <label class="col-form-label">[[[No Data Action]]]</label>
                    <div class="dataset-field">
                        <select id="NoDataActionOption_Value"
                                name="NoDataActionOption_Value"
                                class="no-data-action-select">
                            <option value="SkipAttachment">[[[Skip Attachment]]]</option>
                            <option value="SkipMail">[[[Skip Mail]]]</option>
                        </select>
                        <span class="text-danger error-message"></span>
                    </div>
                </div>
            }
        }

        <!-- ================= STORAGE TYPE ================= -->

        <div class="delivery-row row " data-row-key="FileStorageType">

            <label class="col-form-label">[[[File Storage Type]]]</label>

            <div class="">
                <select id="storage-type-select"
                        name="storage-type-select"
                        class="storage-type-select">
                    <option value="SaveAs">[[[Local File]]]</option>
                    <option value="Mail">[[[Mail]]]</option>
                </select>
                <span class="text-danger error-message"></span>
            </div>

        </div>
        <!-- ================= Mail ================= -->
        @foreach (var field in mailOptionsFields)
        {
            <div class="delivery-row row storage-option Mail d-none"
                 data-row-key="@field.Key">

                <label class="col-form-label">@Html.Raw(field.Label)</label>

                <!-- Source: EJ DropDownList -->
                <div class="sourcetype">
                    <select id="@(field.Key)_Source"
                            name="@(field.Key)_Source"
                            class="source-select"
                            data-default="dataset">
                        <option value="dataset">Choose field from dataset</option>
                        <option value="value">Enter value</option>
                    </select>
                </div>

                <!-- Dataset: EJ DropDownList -->
                <div class="dataset-field">
                    <select id="@(field.Key)_Field"
                            name="@(field.Key)_Field"
                            class="dataset-dropdown"
                            data-row-key="@field.Key">
                        @foreach (var opt in datasetFieldOptions)
                        {
                            <option value="@opt.Value">@opt.Text</option>
                        }
                    </select>
                    <span class="text-danger error-message"></span>
                </div>

                <!-- Value -->
                <div class="value-field d-none">
                    @if (field.Type == "bool")
                    {
                        <select id="@(field.Key)_Value"
                                name="@(field.Key)_Value"
                                class="value-input">
                            <option value="">[[[Select]]]</option>
                            <option value="true">[[[True]]]</option>
                            <option value="false">[[[False]]]</option>
                        </select>
                    }
                    else if (field.Type == "Template")
                    {
                        <select id="@(field.Key)_Value"
                                name="@(field.Key)_Value"
                                class="value-input">
                            <option value="">[[[Select]]]</option>
                            <option value="Default">[[[EmailDefaultTemplate]]]</option>
                        </select>
                    }
                    else
                    {
                        <input type="@field.Type"
                               class="form-control value-input"
                               placeholder="@field.Placeholder" />
                    }
                    <span class="text-danger error-message"></span>
                </div>

            </div>
        }
        <!-- ================= LOCAL STORAGE ================= -->
        @foreach (var field in localStorageFields)
        {
            <div class="delivery-row row  storage-option SaveAs d-none"
                 data-row-key="@field.Key">

                <label class="col-form-label">@Html.Raw(field.Label)</label>

                <!-- Source: EJ DropDownList -->
                <div class="sourcetype">
                    <select id="@(field.Key)_Source"
                            name="@(field.Key)_Source"
                            class="source-select"
                            data-default="dataset">
                        <option value="dataset">Choose field from dataset</option>
                        <option value="value">Enter value</option>
                    </select>
                </div>

                <!-- Dataset: EJ DropDownList -->
                <div class="dataset-field">
                    <select id="@(field.Key)_Field"
                            name="@(field.Key)_Field"
                            class="dataset-dropdown"
                            data-row-key="@field.Key">
                        @foreach (var opt in datasetFieldOptions)
                        {
                            <option value="@opt.Value">@opt.Text</option>
                        }
                    </select>
                    <span class="text-danger error-message"></span>
                </div>

                <!-- Value -->
                <div class="value-field d-none">
                    @if (field.Type == "bool")
                    {
                        <select id="@(field.Key)_Value"
                                name="@(field.Key)_Value"
                                class="value-input">
                            <option value="">[[[Select]]]</option>
                            <option value="true">[[[True]]]</option>
                            <option value="false">[[[False]]]</option>
                        </select>
                    }
                    else
                    {
                        <input type="@field.Type"
                               class="form-control value-input"
                               placeholder="@field.Placeholder" />
                    }
                    <span class="text-danger error-message"></span>
                </div>

            </div>
        }

        <!-- ================= S3 ================= -->
        @foreach (var field in s3StorageFields)
        {
            <div class="delivery-row row storage-option S3 d-none"
                 data-row-key="@field.Key">

                <label class="col-form-label">@Html.Raw(field.Label)</label>

                <!-- Source: EJ DropDownList -->
                <div class="sourcetype">
                    <select id="@(field.Key)_Source"
                            name="@(field.Key)_Source"
                            class="source-select"
                            data-default="dataset">
                        <option value="dataset">Choose field from dataset</option>
                        <option value="value">Enter value</option>
                    </select>
                </div>

                <!-- Dataset: EJ DropDownList -->
                <div class="dataset-field">
                    <select id="@(field.Key)_Field"
                            name="@(field.Key)_Field"
                            class="dataset-dropdown"
                            data-row-key="@field.Key">
                        @foreach (var opt in datasetFieldOptions)
                        {
                            <option value="@opt.Value">@opt.Text</option>
                        }
                    </select>
                    <span class="text-danger error-message"></span>
                </div>

                <!-- Value -->
                <div class="value-field d-none">
                    <input type="@field.Type"
                           class="form-control value-input"
                           placeholder="@field.Placeholder" />
                    <span class="text-danger error-message"></span>
                </div>

            </div>
        }

        <!-- ================= FTP ================= -->
        @foreach (var field in ftpStorageFields)
        {
            <div class="delivery-row row storage-option FTP d-none"
                 data-row-key="@field.Key">

                <label class="col-form-label">@Html.Raw(field.Label)</label>

                <!-- Source: EJ DropDownList -->
                <div class="sourcetype">
                    <select id="@(field.Key)_Source"
                            name="@(field.Key)_Source"
                            class="source-select"
                            data-default="dataset">
                        <option value="dataset">Choose field from dataset</option>
                        <option value="value">Enter value</option>
                    </select>
                </div>

                <div class="dataset-field">
                    <select id="@(field.Key)_Field"
                            name="@(field.Key)_Field"
                            class="dataset-dropdown"
                            data-row-key="@field.Key">
                        @foreach (var opt in datasetFieldOptions)
                        {
                            <option value="@opt.Value">@opt.Text</option>
                        }
                    </select>
                    <span class="text-danger error-message"></span>
                </div>

                <!-- Value -->
                <div class="value-field d-none">
                    <input type="@field.Type"
                           class="form-control value-input"
                           placeholder="@field.Placeholder" />
                    <span class="text-danger error-message"></span>
                </div>

            </div>
        }

    </div>
</div>

